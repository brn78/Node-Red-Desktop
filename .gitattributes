# Normalizzazione fine riga: nel repository sempre LF, nel working tree
# Windows (Visual Studio) CRLF per i sorgenti .NET.
* text=auto

*.vb      text eol=crlf
*.vbproj  text eol=crlf
*.sln     text eol=crlf
*.resx    text eol=crlf
*.settings text eol=crlf
*.config  text eol=crlf
*.iss     text eol=crlf
*.md      text
*.gitignore text
*.gitattributes text

# Binari
*.ico binary
*.png binary
*.exe binary
*.dll binary
*.pdb binary
